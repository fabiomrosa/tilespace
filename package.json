{
  "name": "tilespace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.include='packages/*/src/**' --coverage.thresholds.lines=80",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@vitest/coverage-v8": "5.1.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
